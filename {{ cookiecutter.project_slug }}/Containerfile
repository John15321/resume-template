# Reproducible LaTeX build environment for this CV.
# Normally driven by the Makefile (make pdf). Manual build:
#   podman build -t <image> -f Containerfile .   (docker works too)
FROM registry.fedoraproject.org/fedora:45

RUN dnf install -y \
        texlive-scheme-basic \
        texlive-collection-fontsrecommended \
        texlive-collection-latexextra \
        texlive-collection-fontsextra \
        latexmk \
        make \
    && dnf clean all

WORKDIR /workspace
